<!-- Espaço publicitário: o formato é adaptado pelo JS conforme o breakpoint. -->
<div class="ad-slot ad-slot-<%= formato %>"
     data-ad-slot="<%= identificador %>"
     data-ad-desktop-format="<%= formato %>"
     data-ad-mobile-format="quadrado"
     data-ad-format="<%= formato %>"
     aria-label="Publicidade">
  <span class="ad-etiqueta">Publicidade</span>
  <img class="ad-imagem" src="/img/anuncios/anuncio-<%= formato %>-1.png" alt="Anúncio demonstrativo" loading="lazy" decoding="async">
</div>
